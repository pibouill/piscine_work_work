clear
while true; do
    for i in {0..20}; do
        printf "\r[%s]" "$(printf '#%.0s' $(seq 1 $i) 2>/dev/null)$(printf '.%.0s' $(seq 1 $((21-$i))) 2>/dev/null)"
        sleep 0.1
    done
done
